{
  "name": "@stockwise/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate && prisma generate --config prisma.sqlite.config.ts",
    "validate": "prisma validate && prisma validate --config prisma.sqlite.config.ts",
    "migrate:demo": "prisma migrate deploy --config prisma.sqlite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.9",
    "mariadb": "3.5.4",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  }
}
